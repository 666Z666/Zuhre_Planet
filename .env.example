# ====================================
# Zühre Planet - Ortam Değişkenleri
# PostgreSQL + Ayrı Frontend / Node Backend
# ====================================

# ------------------------------------
# Backend / API
# ------------------------------------
NODE_ENV=development
PORT=4000
JWT_SECRET=degistir-beni-en-az-32-karakterlik-secret
JWT_REFRESH_SECRET=degistir-beni-en-az-32-karakterlik-refresh-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Virgülle ayrılmış origin listesi
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------
# Veritabanı
# ------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zuhre_planet

# ------------------------------------
# Frontend Runtime
# ------------------------------------
VITE_APP_NAME=Zuhre Planet
APP_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000/ws
VITE_ENABLE_AGE_VERIFICATION=true
# İlan kaynağı: api = gerçek backend (yayında zorunlu), mock = demo verisi
VITE_LISTING_SOURCE=mock
# İletişim numarası şifreleme anahtarı (64 hex). Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_ENC_KEY=

# ------------------------------------
# Gözlemlenebilirlik
# ------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=

# ------------------------------------
# Payment ve Email
# Production'da IYZICO_API_KEY, IYZICO_SECRET_KEY, EMAIL_USER ve EMAIL_PASSWORD zorunludur.
# Development'ta boş bırakılırsa ödeme mock akışları ve email json transport kullanılır.
# ------------------------------------
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@zuhreplanet.local
EMAIL_FROM_NAME=Zuhre Planet

# ------------------------------------
# Opsiyonel Harici Servisler
# ------------------------------------
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
ALLOW_INSECURE_SOCIAL_AUTH=false
LEONARDO_API_KEY=
OLLAMA_URL=http://localhost:4060
OLLAMA_API_BASE=http://localhost:4060
AI_PROXY_URL=http://localhost:4080

# ------------------------------------
# Production Örneği
# ------------------------------------
# NODE_ENV=production
# PORT=4000
# DATABASE_URL=postgres://user:password@postgres:5432/zuhre_planet
# JWT_SECRET=uzun-ve-rastgele-bir-secret
# JWT_REFRESH_SECRET=uzun-ve-rastgele-bir-refresh-secret
# CORS_ORIGINS=https://app.example.com
# APP_URL=https://app.example.com
# VITE_APP_URL=https://app.example.com
# VITE_API_URL=https://api.example.com/api
# VITE_WS_URL=wss://api.example.com/ws
# IYZICO_API_KEY=prod-iyzico-api-key
# IYZICO_SECRET_KEY=prod-iyzico-secret-key
# EMAIL_HOST=smtp.example.com
# EMAIL_USER=mailer@example.com
# EMAIL_PASSWORD=prod-email-password
# SENTRY_DSN=https://example@sentry.io/123
# VITE_SENTRY_DSN=https://example@sentry.io/456

# ------------------------------------
# API Modu (true = gerçek API, false = mock)
# ------------------------------------
VITE_ENABLE_REAL_API=false
